<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keystore keys cannot be transferred; exclude their encrypted preferences too. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
